@page "/"
@inject NavigationManager Navigation

<PageTitle>LenaMiu 應援網站</PageTitle>

<header class="site-header" id="top">
    <a class="brand" href="#top">
        <span class="brand-mark">S</span>
        <span>Support<br />with Love</span>
    </a>

    <nav class="main-nav" aria-label="main navigation">
        <a href="@(isEnglish ? "lena?lang=en" : "lena")">Lena</a>
        <a href="@(isEnglish ? "miu?lang=en" : "miu")">Miu</a>
        <a href="@(isEnglish ? "gumber-bear?lang=en" : "gumber-bear")">Gumber bear</a>
    </nav>

    <button class="menu-button language-button" type="button" @onclick="ToggleLanguage" aria-label="@(isEnglish ? "切換為中文" : "Switch to English")">
        @(isEnglish ? "中文" : "EN")
    </button>
</header>

<main>
    <section class="hero section-wrap">
        <div class="hero-content">
            <h1>LenaMiu</h1>
            @if (isEnglish)
            {
                <p>LenaMiu is a popular actress duo under Thailand's Channel 3, consisting of Lena Lalina (Lalina Schuett / Lalina Lena) and Miu Natsha (Natsha Taechamongkalapiwat). The pair gained widespread attention through their performance in the Thai GL series <em>My Safe Zone</em> as Alin and Jane.</p>
            }
            else
            {
                <p>LenaMiu 是泰國第3電視台旗下的超人氣女演員雙人組合，由 Lena Lalina（Lalina Schuett / Lalina Lena）與 Miu Natsha（Natsha Taechamongkalapiwat）組成。兩人因合作演出泰國百GL劇集《my safe zone》（AlinJane）而備受矚目。</p>
            }
        </div>
        <div class="image-box hero-image">圖1</div>
    </section>

    <section class="gallery section-wrap" aria-label="gallery">
        <div class="image-box gallery-image image-two">圖2</div>
        <div class="image-box gallery-image image-three">圖3</div>
        <div class="image-box gallery-image image-four">圖4</div>
        <div class="image-box gallery-image image-five">圖5</div>
    </section>

    <section class="service" id="service">
        <h2>Service</h2>

        <div class="service-row section-wrap service-row-two">
            <a class="service-item" href="@ServiceHref("schedule")">
                <img class="small-image" src="images/service-schedule.webp" alt="" />
                <p>@(isEnglish ? "Upcoming Events" : "近期行程")</p>
            </a>
            <a class="service-item" href="@ServiceHref("materials")">
                <img class="small-image" src="images/service-materials.webp" alt="" />
                <p>@(isEnglish ? "Materials" : "物料總覽")</p>
            </a>
        </div>

        <div class="service-row section-wrap service-row-one">
            <a class="service-item" href="@ServiceHref("interviews")">
                <img class="small-image" src="images/service-interviews.webp" alt="" />
                <p>@(isEnglish ? "Interviews" : "採訪整理")</p>
            </a>
        </div>

        <div class="service-row section-wrap service-row-two">
            <a class="service-item" href="@ServiceHref("fanfiction")">
                <img class="small-image" src="images/service-fanfiction.webp" alt="" />
                <p>@(isEnglish ? "Fanfiction Collection" : "同人文合集")</p>
            </a>
            <a class="service-item" href="@ServiceHref("live-videos")">
                <img class="small-image" src="images/service-live-videos.webp" alt="" />
                <p>@(isEnglish ? "Live Videos" : "直播影片")</p>
            </a>
        </div>
    </section>
</main>

<footer class="site-footer">
    <div class="footer-brand">
        <span class="brand-mark">S</span>
        <span>Support site</span>
    </div>
    <p>Made in Line</p>
    <a href="#top">Top ↑</a>
</footer>

@code {
    private bool isEnglish;

    protected override void OnInitialized()
    {
        isEnglish = Navigation.ToAbsoluteUri(Navigation.Uri).Query.Contains("lang=en", StringComparison.OrdinalIgnoreCase);
    }

    private void ToggleLanguage()
    {
        isEnglish = !isEnglish;
        Navigation.NavigateTo(isEnglish ? "./?lang=en" : "./", replace: true);
    }

    private string ServiceHref(string slug) => isEnglish ? $"service/{slug}?lang=en" : $"service/{slug}";
}
