@page "/service/interviews"
@inject NavigationManager Navigation

<PageTitle>@(IsEnglish ? "Interviews" : "採訪整理")</PageTitle>

<header class="site-header" id="top">
    <a class="brand" href="@HomeHref">
        <span class="brand-mark">S</span>
        <span>Support<br />with Love</span>
    </a>

    <nav class="main-nav" aria-label="main navigation">
        <a href="@LenaHref">Lena</a>
        <a href="@MiuHref">Miu</a>
        <a href="@GumberBearHref">Gumber bear</a>
    </nav>

    <a class="menu-button home-button" href="@HomeHref">@(IsEnglish ? "Home" : "回首頁")</a>
</header>

<main class="service-page">
    <section class="materials-section interviews-section" aria-labelledby="interviews-title">
        @if (SelectedInterviewYear is null)
        {
            <div class="materials-heading">
                <p>@(IsEnglish ? "Archive" : "年份整理")</p>
                <h1 id="interviews-title">@(IsEnglish ? "Interviews" : "採訪整理")</h1>
            </div>

            <div class="year-card-grid">
                @foreach (var year in InterviewYears)
                {
                    <button type="button" class="year-card @(year == 2025 ? "year-card-muted" : string.Empty)" @onclick="() => OpenInterviewYear(year)">
                        <span>@year</span>
                        <small>@InterviewYearRange(year)</small>
                        <i aria-hidden="true">↗</i>
                    </button>
                }
            </div>

            <p class="schedule-note">
                @(IsEnglish
                    ? "The archive includes checkable official pilots and teasers, Channel 3 programmes, interviews, brand and event coverage, Vlogs, livestreams and other related media. Each type is labeled separately."
                    : "收錄能核對來源的官方 Pilot／預告、三台節目、採訪、品牌／活動紀錄、Vlog、直播與其他相關影音；不同類型會分開標示。")
            </p>
        }
        else if (SelectedInterviewMonth is null)
        {
            <div class="materials-calendar-heading">
                <button type="button" class="materials-back" @onclick="CloseInterviewYear">← @(IsEnglish ? "Years" : "返回年份")</button>
                <div>
                    <p>@(IsEnglish ? "Media archive" : "採訪整理")</p>
                    <h1 id="interviews-title">@SelectedInterviewYear</h1>
                </div>
            </div>

            <div class="interview-month-grid">
                @foreach (var month in InterviewMonths)
                {
                    var count = Interviews.Count(item => item.Year == SelectedInterviewYear && item.Month == month);
                    <button type="button" class="interview-month-card" @onclick="() => OpenInterviewMonth(month)">
                        <span>@month.ToString("00")</span>
                        <div>
                            <strong>@InterviewMonthName(month)</strong>
                            <small>@(IsEnglish ? $"{count} items" : $"{count} 筆內容")</small>
                        </div>
                        <i aria-hidden="true">↗</i>
                    </button>
                }
            </div>
        }
        else
        {
            <div class="materials-calendar-heading interview-list-heading">
                <button type="button" class="materials-back" @onclick="CloseInterviewMonth">← @(IsEnglish ? "Months" : "返回月份")</button>
                <div>
                    <p>@SelectedInterviewYear</p>
                    <h1 id="interviews-title">@InterviewMonthName(SelectedInterviewMonth.Value)</h1>
                </div>
            </div>

            @if (!InterviewsForMonth.Any())
            {
                <p class="schedule-note">
                    @(IsEnglish
                        ? "No sufficiently clear, checkable related content has been added for this month yet. Official, media or mirror sources are only included when the date and source can be verified."
                        : "這個月目前還沒有找到來源夠明確、可核對的相關內容；有日期與來源的官方／媒體／搬運資料才會加入。")
                </p>
            }
            else
            {
                <div class="interview-list">
                    @foreach (var item in InterviewsForMonth)
                    {
                        <article class="interview-row">
                            <span class="interview-date"><b>@item.Day.ToString("00")</b><small>@InterviewMonthShort(item.Month)</small></span>
                            <span class="interview-row-copy">
                                <small>@InterviewType(item) · @item.Person</small>
                                <strong>@InterviewTitle(item)</strong>
                                <span class="interview-row-sources">
                                    @foreach (var link in item.Links)
                                    {
                                        <a href="@link.Url" target="_blank" rel="noopener noreferrer">@link.Platform</a>
                                    }
                                </span>
                            </span>
                        </article>
                    }
                </div>
            }
        }
    </section>
</main>

@code {
    private bool IsEnglish => Navigation.ToAbsoluteUri(Navigation.Uri).Query.Contains("lang=en", StringComparison.OrdinalIgnoreCase);
    private string HomeHref => IsEnglish ? $"{Navigation.BaseUri}?lang=en" : Navigation.BaseUri;
    private string LenaHref => ProfileHref("lena");
    private string MiuHref => ProfileHref("miu");
    private string GumberBearHref => ProfileHref("gumber-bear");

    private string ProfileHref(string page) => IsEnglish ? $"{Navigation.BaseUri}{page}?lang=en" : $"{Navigation.BaseUri}{page}";

    private int? SelectedInterviewYear { get; set; }
    private int? SelectedInterviewMonth { get; set; }

    private int[] InterviewYears => [2025, 2026];

    private IEnumerable<int> InterviewMonths => SelectedInterviewYear switch
    {
        2025 => Enumerable.Range(1, 12),
        2026 => Enumerable.Range(1, 7),
        _ => []
    };

    private IEnumerable<InterviewItem> InterviewsForMonth => Interviews
        .Where(item => item.Year == SelectedInterviewYear && item.Month == SelectedInterviewMonth)
        .OrderBy(item => item.Day)
        .ThenBy(item => item.TitleEn);

    private string InterviewYearRange(int year) => year switch
    {
        2025 => IsEnglish ? "January — December" : "1 月—12 月",
        2026 => IsEnglish ? "March — July" : "3 月—7 月",
        _ => string.Empty
    };

    private string InterviewMonthName(int month) => IsEnglish
        ? new DateTime(2026, month, 1).ToString("MMMM", System.Globalization.CultureInfo.InvariantCulture)
        : $"{month} 月";

    private string InterviewMonthShort(int month) => IsEnglish
        ? new DateTime(2026, month, 1).ToString("MMM", System.Globalization.CultureInfo.InvariantCulture).ToUpperInvariant()
        : $"{month} 月";

    private string InterviewTitle(InterviewItem item) => IsEnglish ? item.TitleEn : item.TitleZh;
    private string InterviewType(InterviewItem item) => IsEnglish ? item.TypeEn : item.TypeZh;

    private void OpenInterviewYear(int year)
    {
        SelectedInterviewYear = year;
        SelectedInterviewMonth = null;
    }

    private void CloseInterviewYear()
    {
        SelectedInterviewYear = null;
        SelectedInterviewMonth = null;
    }

    private void OpenInterviewMonth(int month) => SelectedInterviewMonth = month;
    private void CloseInterviewMonth() => SelectedInterviewMonth = null;

