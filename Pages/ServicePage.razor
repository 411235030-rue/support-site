@page "/service/{Slug}"
@inject NavigationManager Navigation

<PageTitle>@PageName</PageTitle>

<header class="site-header" id="top">
    <a class="brand" href="@HomeHref">
        <span class="brand-mark">S</span>
        <span>Support<br />with Love</span>
    </a>

    <nav class="main-nav" aria-label="main navigation">
        <a href="@LenaHref">Lena</a>
        <a href="@MiuHref">Miu</a>
        <a href="@GumberBearHref">Gumber bear</a>
    </nav>

    <a class="menu-button home-button" href="@HomeHref">@(IsEnglish ? "Home" : "回首頁")</a>
</header>

<main class="service-page">
    @if (Slug == "schedule")
    {
        <section class="schedule-section" aria-labelledby="schedule-title">
            <div class="schedule-heading">
                <p>@(IsEnglish ? "Upcoming events" : "近期行程")</p>
                <h1 id="schedule-title">@(IsEnglish ? "August 2026" : "2026 年 8 月")</h1>
                <div class="schedule-legend" aria-label="活動標示說明">
                    <span><i class="status-dot public"></i>@(IsEnglish ? "Public event" : "公開活動")</span>
                    <span><i class="status-dot private"></i>@(IsEnglish ? "Private event" : "私人活動")</span>
                    <span><i class="status-dot notice"></i>@(IsEnglish ? "No gathering or gifts" : "活動後不聚會、不收禮物")</span>
                </div>
            </div>

            <div class="calendar" aria-label="2026 年 8 月行程月曆">
                <div class="calendar-weekdays" aria-hidden="true">
                    @foreach (var weekday in Weekdays)
                    {
                        <span>@weekday</span>
                    }
                </div>
                <div class="calendar-grid">
                    @for (var blank = 0; blank < 6; blank++)
                    {
                        <div class="calendar-day calendar-empty" aria-hidden="true"></div>
                    }
                    @for (var day = 1; day <= 31; day++)
                    {
                        var currentDay = day;
                        var dayEvent = Events.FirstOrDefault(item => item.Day == currentDay);
                        <button type="button"
                                class="calendar-day @(dayEvent is null ? string.Empty : "has-event") @(ActiveDay == currentDay ? "is-active" : string.Empty)"
                                aria-label="@DayLabel(currentDay, dayEvent)"
                                aria-expanded="@(dayEvent is not null && ActiveDay == currentDay)"
                                @onclick="() => ToggleDay(currentDay, dayEvent)">
                            <span class="calendar-date">@currentDay</span>
                            @if (dayEvent is not null)
                            {
                                <span class="calendar-event-name">@EventTitle(dayEvent)</span>
                                <span class="calendar-dots" aria-hidden="true">
                                    @foreach (var status in dayEvent.Statuses)
                                    {
                                        <i class="status-dot @status"></i>
                                    }
                                </span>
                                <span class="event-popover" role="status">
                                    <strong>@EventTitle(dayEvent)</strong>
                                    <span class="event-person">@dayEvent.Person</span>
                                    @if (!string.IsNullOrWhiteSpace(dayEvent.Time))
                                    {
                                        <span>@(IsEnglish ? "Time" : "時間")｜@dayEvent.Time</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(dayEvent.Venue))
                                    {
                                        <span>@(IsEnglish ? "Venue" : "地點")｜@dayEvent.Venue</span>
                                        <a href="@dayEvent.MapUrl" target="_blank" rel="noopener noreferrer" @onclick:stopPropagation="true">
                                            @(IsEnglish ? "Open in Google Maps ↗" : "在 Google Maps 查看 ↗")
                                        </a>
                                    }
                                    @if (dayEvent.IsPrivate)
                                    {
                                        <em>@(IsEnglish ? "Private event" : "此為私人活動")</em>
                                    }
                                </span>
                            }
                        </button>
                    }
                </div>
            </div>

            <p class="schedule-note">
                @(IsEnglish
                    ? "Other dates in August are reserved for filming. The schedule may be adjusted as necessary."
                    : "8 月其餘日期預留作戲劇拍攝；行程可能依實際情況調整。")
            </p>
        </section>
    }
    else if (Slug == "materials")
    {
        <section class="materials-section" aria-labelledby="materials-title">
            @if (SelectedMaterialYear is null)
            {
                <div class="materials-heading">
                    <p>@(IsEnglish ? "Archive" : "年份整理")</p>
                    <h1 id="materials-title">@(IsEnglish ? "Materials" : "物料總覽")</h1>
                </div>

                <div class="year-card-grid">
                    <button type="button" class="year-card year-card-muted" @onclick="() => SelectedMaterialYear = 2025">
                        <span>2025</span>
                        <small>@(IsEnglish ? "February — December" : "2 月—12 月")</small>
                        <i aria-hidden="true">↗</i>
                    </button>
                    <button type="button" class="year-card" @onclick="() => SelectedMaterialYear = 2026">
                        <span>2026</span>
                        <small>@(IsEnglish ? "January — July" : "1 月—7 月")</small>
                        <i aria-hidden="true">↗</i>
                    </button>
                </div>
            }
            else
            {
                <div class="materials-calendar-heading">
                    <button type="button" class="materials-back" @onclick="() => SelectedMaterialYear = null">
                        ← @(IsEnglish ? "Years" : "返回年份")
                    </button>
                    <div>
                        <p>@(IsEnglish ? "Materials archive" : "物料總覽")</p>
                        <h1 id="materials-title">@SelectedMaterialYear</h1>
                    </div>
                </div>

                <div class="month-calendar-grid @(MaterialMonths.Count() % 2 == 1 ? "has-odd" : string.Empty)">
                    @foreach (var month in MaterialMonths)
                    {
                        var year = SelectedMaterialYear!.Value;
                        var daysInMonth = DateTime.DaysInMonth(year, month);
                        var firstWeekday = (int)new DateTime(year, month, 1).DayOfWeek;
                        <article class="month-calendar">
                            <header>
                                <span>@month.ToString("00")</span>
                                <h2>@MonthName(month)</h2>
                            </header>
                            <div class="mini-weekdays" aria-hidden="true">
                                @foreach (var weekday in MiniWeekdays)
                                {
                                    <span>@weekday</span>
                                }
                            </div>
                            <div class="mini-days">
                                @for (var blank = 0; blank < firstWeekday; blank++)
                                {
                                    <span aria-hidden="true"></span>
                                }
                                @for (var day = 1; day <= daysInMonth; day++)
                                {
                                    var currentDay = day;
                                    var dayEvents = MaterialEventsForDay(year, month, currentDay);
                                    if (dayEvents.Count == 0)
                                    {
                                        <span>@currentDay</span>
                                    }
                                    else
                                    {
                                        var dayKey = $"{year}-{month}-{currentDay}";
                                        <button type="button"
                                                class="material-day has-material-event @(ActiveMaterialDay == dayKey ? "is-active" : string.Empty)"
                                                aria-expanded="@(ActiveMaterialDay == dayKey)"
                                                @onclick="() => ToggleMaterialDay(dayKey)">
                                            <b>@currentDay</b>
                                            <span class="material-day-dots" aria-hidden="true">
                                                @foreach (var status in dayEvents.SelectMany(item => item.Statuses).Distinct())
                                                {
                                                    <i class="status-dot @status"></i>
                                                }
                                            </span>
                                            <span class="material-popover" role="status">
                                                @foreach (var item in dayEvents)
                                                {
                                                    <span class="material-event-detail">
                                                        <strong>@MaterialEventTitle(item)</strong>
                                                        <em>@item.Person</em>
                                                        @if (!string.IsNullOrWhiteSpace(item.Time))
                                                        {
                                                            <span>@(IsEnglish ? "Time" : "時間")｜@item.Time</span>
                                                        }
                                                        @if (!string.IsNullOrWhiteSpace(item.Venue))
                                                        {
                                                            <span>@(IsEnglish ? "Venue" : "地點")｜@item.Venue</span>
                                                        }
                                                        @if (!string.IsNullOrWhiteSpace(MaterialEventNote(item)))
                                                        {
                                                            <small>@MaterialEventNote(item)</small>
                                                        }
                                                        @if (item.Links is not null && item.Links.Length > 0)
                                                        {
                                                            <span class="material-source-links">
                                                                <span>@(IsEnglish ? "Fan photos" : "相關飯拍")</span>
                                                                @foreach (var link in item.Links)
                                                                {
                                                                    <a href="@link.Url" target="_blank" rel="noopener noreferrer" @onclick:stopPropagation="true">
                                                                        @(IsEnglish ? link.LabelEn : link.LabelZh) ↗
                                                                    </a>
                                                                }
                                                            </span>
                                                        }
                                                        @if (item.Tags is not null && item.Tags.Length > 0)
                                                        {
                                                            <span class="material-tag-links">
                                                                <span>Tags</span>
                                                                @foreach (var tag in item.Tags)
                                                                {
                                                                    <a href="@XTagHref(tag)" target="_blank" rel="noopener noreferrer" @onclick:stopPropagation="true">@tag</a>
                                                                }
                                                            </span>
                                                        }
                                                    </span>
                                                }
                                            </span>
                                        </button>
                                    }
                                }
                            </div>
                        </article>
                    }
                </div>
            }
        </section>
    }
    else if (Slug == "interviews")
    {
        <section class="materials-section interviews-section" aria-labelledby="interviews-title">
            @if (SelectedInterviewYear is null)
            {
                <div class="materials-heading">
                    <p>@(IsEnglish ? "Archive" : "年份整理")</p>
                    <h1 id="interviews-title">@(IsEnglish ? "Interviews" : "採訪整理")</h1>
                </div>
                <div class="year-card-grid">
                    @foreach (var year in InterviewYears)
                    {
                        <button type="button" class="year-card @(year == 2025 ? "year-card-muted" : string.Empty)" @onclick="() => OpenInterviewYear(year)">
                            <span>@year</span>
                            <small>@InterviewYearRange(year)</small>
                            <i aria-hidden="true">↗</i>
                        </button>
                    }
                </div>
            }
            else if (SelectedInterviewMonth is null)
            {
                <div class="materials-calendar-heading">
                    <button type="button" class="materials-back" @onclick="CloseInterviewYear">← @(IsEnglish ? "Years" : "返回年份")</button>
                    <div>
                        <p>@(IsEnglish ? "Interview archive" : "採訪整理")</p>
                        <h1 id="interviews-title">@SelectedInterviewYear</h1>
                    </div>
                </div>
                <div class="interview-month-grid">
                    @foreach (var month in InterviewMonths)
                    {
                        var count = Interviews.Count(item => item.Year == SelectedInterviewYear && item.Month == month);
                        <button type="button" class="interview-month-card" @onclick="() => OpenInterviewMonth(month)">
                            <span>@month.ToString("00")</span>
                            <div><strong>@InterviewMonthName(month)</strong><small>@(IsEnglish ? $"{count} interviews" : $"{count} 篇採訪")</small></div>
                            <i aria-hidden="true">↗</i>
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="materials-calendar-heading interview-list-heading">
                    <button type="button" class="materials-back" @onclick="CloseInterviewMonth">← @(IsEnglish ? "Months" : "返回月份")</button>
                    <div>
                        <p>@SelectedInterviewYear</p>
                        <h1 id="interviews-title">@InterviewMonthName(SelectedInterviewMonth.Value)</h1>
                    </div>
                </div>
                <div class="interview-list">
                    @foreach (var item in InterviewsForMonth)
                    {
                        <article class="interview-row">
                            <span class="interview-date"><b>@item.Day.ToString("00")</b><small>@InterviewMonthShort(item.Month)</small></span>
                            <span class="interview-row-copy">
                                <small>@InterviewType(item) · @item.Person</small>
                                <strong>@InterviewTitle(item)</strong>
                                <span class="interview-row-sources">
                                    @foreach (var link in item.Links)
                                    {
                                        <a href="@link.Url" target="_blank" rel="noopener noreferrer">@link.Platform</a>
                                    }
                                </span>
                            </span>
                        </article>
                    }
                </div>
            }
        </section>
    }
</main>

