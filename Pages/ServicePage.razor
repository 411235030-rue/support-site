@page "/service/{Slug}"
@inject NavigationManager Navigation

<PageTitle>@PageName</PageTitle>

<header class="site-header" id="top">
    <a class="brand" href="@HomeHref">
        <span class="brand-mark">S</span>
        <span>Support<br />with Love</span>
    </a>

    <nav class="main-nav" aria-label="main navigation">
        <a href="@LenaHref">Lena</a>
        <a href="@MiuHref">Miu</a>
        <a href="@GumberBearHref">Gumber bear</a>
    </nav>

    <a class="menu-button home-button" href="@HomeHref">@(IsEnglish ? "Home" : "回首頁")</a>
</header>

<main class="service-page">
    @if (Slug == "schedule")
    {
        <section class="schedule-section" aria-labelledby="schedule-title">
            <div class="schedule-heading">
                <p>@(IsEnglish ? "Upcoming events" : "近期行程")</p>
                <h1 id="schedule-title">@(IsEnglish ? "August 2026" : "2026 年 8 月")</h1>
                <div class="schedule-legend" aria-label="活動標示說明">
                    <span><i class="status-dot public"></i>@(IsEnglish ? "Public event" : "公開活動")</span>
                    <span><i class="status-dot private"></i>@(IsEnglish ? "Private event" : "私人活動")</span>
                    <span><i class="status-dot notice"></i>@(IsEnglish ? "No gathering or gifts" : "活動後不聚會、不收禮物")</span>
                </div>
            </div>

            <div class="calendar" aria-label="2026 年 8 月行程月曆">
                <div class="calendar-weekdays" aria-hidden="true">
                    @foreach (var weekday in Weekdays)
                    {
                        <span>@weekday</span>
                    }
                </div>
                <div class="calendar-grid">
                    @for (var blank = 0; blank < 6; blank++)
                    {
                        <div class="calendar-day calendar-empty" aria-hidden="true"></div>
                    }
                    @for (var day = 1; day <= 31; day++)
                    {
                        var currentDay = day;
                        var dayEvent = Events.FirstOrDefault(item => item.Day == currentDay);
                        <button type="button"
                                class="calendar-day @(dayEvent is null ? string.Empty : "has-event") @(ActiveDay == currentDay ? "is-active" : string.Empty)"
                                aria-label="@DayLabel(currentDay, dayEvent)"
                                aria-expanded="@(dayEvent is not null && ActiveDay == currentDay)"
                                @onclick="() => ToggleDay(currentDay, dayEvent)">
                            <span class="calendar-date">@currentDay</span>
                            @if (dayEvent is not null)
                            {
                                <span class="calendar-event-name">@EventTitle(dayEvent)</span>
                                <span class="calendar-dots" aria-hidden="true">
                                    @foreach (var status in dayEvent.Statuses)
                                    {
                                        <i class="status-dot @status"></i>
                                    }
                                </span>
                                <span class="event-popover" role="status">
                                    <strong>@EventTitle(dayEvent)</strong>
                                    <span class="event-person">@dayEvent.Person</span>
                                    @if (!string.IsNullOrWhiteSpace(dayEvent.Time))
                                    {
                                        <span>@(IsEnglish ? "Time" : "時間")｜@dayEvent.Time</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(dayEvent.Venue))
                                    {
                                        <span>@(IsEnglish ? "Venue" : "地點")｜@dayEvent.Venue</span>
                                        <a href="@dayEvent.MapUrl" target="_blank" rel="noopener noreferrer" @onclick:stopPropagation="true">
                                            @(IsEnglish ? "Open in Google Maps ↗" : "在 Google Maps 查看 ↗")
                                        </a>
                                    }
                                    @if (dayEvent.IsPrivate)
                                    {
                                        <em>@(IsEnglish ? "Private event" : "此為私人活動")</em>
                                    }
                                </span>
                            }
                        </button>
                    }
                </div>
            </div>

            <p class="schedule-note">
                @(IsEnglish
                    ? "Other dates in August are reserved for filming. The schedule may be adjusted as necessary."
                    : "8 月其餘日期預留作戲劇拍攝；行程可能依實際情況調整。")
            </p>
        </section>
    }
    else if (Slug == "materials")
    {
        <section class="materials-section" aria-labelledby="materials-title">
            @if (SelectedMaterialYear is null)
            {
                <div class="materials-heading">
                    <p>@(IsEnglish ? "Archive" : "年份整理")</p>
                    <h1 id="materials-title">@(IsEnglish ? "Materials" : "物料總覽")</h1>
                </div>

                <div class="year-card-grid">
                    <button type="button" class="year-card year-card-muted" @onclick="() => SelectedMaterialYear = 2025">
                        <span>2025</span>
                        <small>@(IsEnglish ? "August · December" : "8 月・12 月")</small>
                        <i aria-hidden="true">↗</i>
                    </button>
                    <button type="button" class="year-card" @onclick="() => SelectedMaterialYear = 2026">
                        <span>2026</span>
                        <small>@(IsEnglish ? "January — July" : "1 月—7 月")</small>
                        <i aria-hidden="true">↗</i>
                    </button>
                </div>
            }
            else
            {
                <div class="materials-calendar-heading">
                    <button type="button" class="materials-back" @onclick="() => SelectedMaterialYear = null">
                        ← @(IsEnglish ? "Years" : "返回年份")
                    </button>
                    <div>
                        <p>@(IsEnglish ? "Materials archive" : "物料總覽")</p>
                        <h1 id="materials-title">@SelectedMaterialYear</h1>
                    </div>
                </div>

                <div class="month-calendar-grid @(MaterialMonths.Count() % 2 == 1 ? "has-odd" : string.Empty)">
                    @foreach (var month in MaterialMonths)
                    {
                        var year = SelectedMaterialYear!.Value;
                        var daysInMonth = DateTime.DaysInMonth(year, month);
                        var firstWeekday = (int)new DateTime(year, month, 1).DayOfWeek;
                        var posters = MonthMaterials(year, month);
                        <article class="month-calendar">
                            <header>
                                <span>@month.ToString("00")</span>
                                <h2>@MonthName(month)</h2>
                            </header>
                            <div class="mini-weekdays" aria-hidden="true">
                                @foreach (var weekday in MiniWeekdays)
                                {
                                    <span>@weekday</span>
                                }
                            </div>
                            <div class="mini-days">
                                @for (var blank = 0; blank < firstWeekday; blank++)
                                {
                                    <span aria-hidden="true"></span>
                                }
                                @for (var day = 1; day <= daysInMonth; day++)
                                {
                                    <span>@day</span>
                                }
                            </div>
                            @if (posters.Count > 0)
                            {
                                <div class="material-poster-grid @(posters.Count > 1 ? "has-multiple" : string.Empty)">
                                    @foreach (var poster in posters)
                                    {
                                        <a class="material-poster" href="@poster.Path" target="_blank" rel="noopener noreferrer">
                                            <img src="@poster.Path" alt="@poster.Alt" loading="lazy" />
                                            <span>@(IsEnglish ? "View full image ↗" : "查看完整圖片 ↗")</span>
                                        </a>
                                    }
                                </div>
                            }
                        </article>
                    }
                </div>
            }
        </section>
    }
</main>

@code {
    [Parameter]
    public string Slug { get; set; } = string.Empty;

    private bool IsEnglish => Navigation.ToAbsoluteUri(Navigation.Uri).Query.Contains("lang=en", StringComparison.OrdinalIgnoreCase);
    private string HomeHref => IsEnglish ? $"{Navigation.BaseUri}?lang=en" : Navigation.BaseUri;
    private string LenaHref => ProfileHref("lena");
    private string MiuHref => ProfileHref("miu");
    private string GumberBearHref => ProfileHref("gumber-bear");

    private string ProfileHref(string page) => IsEnglish ? $"{Navigation.BaseUri}{page}?lang=en" : $"{Navigation.BaseUri}{page}";

    private string PageName => Slug switch
    {
        "schedule" => IsEnglish ? "Upcoming Events" : "近期行程",
        "materials" => IsEnglish ? "Materials" : "物料總覽",
        "interviews" => IsEnglish ? "Interviews" : "採訪整理",
        "fanfiction" => IsEnglish ? "Fanfiction Collection" : "同人文合集",
        "live-videos" => IsEnglish ? "Live Videos" : "直播影片",
        _ => "LenaMiu 應援網站"
    };

    private int? ActiveDay { get; set; }
    private int? SelectedMaterialYear { get; set; }
    private IEnumerable<int> MaterialMonths => SelectedMaterialYear == 2025
        ? [8, 12]
        : Enumerable.Range(1, 7);

    private string[] Weekdays => IsEnglish
        ? ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"]
        : ["日", "一", "二", "三", "四", "五", "六"];

    private string[] MiniWeekdays => IsEnglish
        ? ["S", "M", "T", "W", "T", "F", "S"]
        : ["日", "一", "二", "三", "四", "五", "六"];

    private IReadOnlyList<ScheduleEvent> Events =>
    [
        new(1, "LENAMIU", "Girls Cup Presented by มาม่า", "Girls Cup Presented by มาม่า", "02:00 PM", "BITEC Live", Map("BITEC Live Bangkok"), true, ["private"]),
        new(7, "MIU", "Vaseline Pro Derma Glycoxome 快閃實驗室", "Vaseline Pro Derma Glycoxome Pop-Up Lab", "07:00 PM", "Sphere Gallery 1, M Floor, Emsphere", Map("Sphere Gallery 1 Emsphere Bangkok"), false, ["public", "notice"]),
        new(8, "LENAMIU", "Weibo Gala 2026（微博文化交流之夜）", "Weibo Gala 2026 (Weibo Cultural Communication Night)", "", "", "", true, ["private"]),
        new(13, "LENAMIU", "LEGACY", "LEGACY", "05:00 PM", "Charoen Nakhon Hall & Thara Hall, M Level, ICONSIAM", Map("Charoen Nakhon Hall ICONSIAM Bangkok"), false, ["public", "notice"]),
        new(20, "LENA", "《Her in Frame》電影特別放映", "Her in Frame Special Screening", "01:00 PM", "5th Floor, Paragon Cineplex, Siam Paragon", Map("Paragon Cineplex Siam Paragon Bangkok"), false, ["public", "notice"]),
        new(22, "LENAMIU", "LENAMIU 首次新加坡粉絲見面會", "LENAMIU 1st Fan Meeting in Singapore", "", "Singapore", Map("Singapore"), true, ["private"]),
        new(28, "LENAMIU", "Aura No.10 十週年活動", "Aura No.10 10th Anniversary Event", "", "Central Post Office Bang Rak", Map("Central Post Office Bang Rak Bangkok"), true, ["private"])
    ];

    private void ToggleDay(int day, ScheduleEvent? dayEvent)
    {
        if (dayEvent is not null)
        {
            ActiveDay = ActiveDay == day ? null : day;
        }
    }

    private string EventTitle(ScheduleEvent item) => IsEnglish ? item.TitleEn : item.TitleZh;

    private string DayLabel(int day, ScheduleEvent? item) => item is null
        ? $"8 月 {day} 日"
        : $"8 月 {day} 日，{EventTitle(item)}";

    private string MonthName(int month) => IsEnglish
        ? new DateTime(SelectedMaterialYear ?? 2026, month, 1).ToString("MMMM", System.Globalization.CultureInfo.InvariantCulture)
        : $"{month} 月";

    private IReadOnlyList<MaterialPoster> MonthMaterials(int year, int month) => MaterialPosters
        .Where(item => item.Year == year && item.Month == month)
        .ToList();

    private static IReadOnlyList<MaterialPoster> MaterialPosters =>
    [
        new(2025, 8, "images/materials/2025-08.jpeg", "LenaMiu 2025 年 8 月行程圖"),
        new(2025, 12, "images/materials/2025-12.jpeg", "LenaMiu 2025 年 12 月行程圖"),
        new(2026, 1, "images/materials/2026-01.jpeg", "LenaMiu 2026 年 1 月行程圖"),
        new(2026, 2, "images/materials/2026-02-b.jpeg", "LenaMiu 2026 年 2 月行程圖"),
        new(2026, 3, "images/materials/2026-03.jpeg", "LenaMiu 2026 年 3 月行程圖"),
        new(2026, 4, "images/materials/2026-04.jpeg", "LenaMiu 2026 年 4 月行程圖"),
        new(2026, 5, "images/materials/2026-05.jpeg", "LenaMiu 2026 年 5 月行程圖"),
        new(2026, 6, "images/materials/2026-06.jpeg", "LenaMiu 2026 年 6 月行程圖"),
        new(2026, 7, "images/materials/2026-07.jpeg", "LenaMiu 2026 年 7 月行程圖")
    ];

    private static string Map(string query) => $"https://www.google.com/maps/search/?api=1&query={Uri.EscapeDataString(query)}";

    private sealed record ScheduleEvent(
        int Day,
        string Person,
        string TitleZh,
        string TitleEn,
        string Time,
        string Venue,
        string MapUrl,
        bool IsPrivate,
        string[] Statuses);

    private sealed record MaterialPoster(int Year, int Month, string Path, string Alt);
}
