@page "/miu"
@inject NavigationManager Navigation

<PageTitle>Miu</PageTitle>

<header class="site-header" id="top">
    <a class="brand" href="@(IsEnglish ? "./?lang=en" : "./")">
        <span class="brand-mark">S</span>
        <span>Support<br />with Love</span>
    </a>

    <nav class="main-nav" aria-label="main navigation">
        <a href="@(IsEnglish ? "lena?lang=en" : "lena")">Lena</a>
        <a href="@(IsEnglish ? "miu?lang=en" : "miu")">Miu</a>
        <a href="@(IsEnglish ? "gumber-bear?lang=en" : "gumber-bear")">Gumber bear</a>
    </nav>

    <a class="menu-button home-button" href="@(IsEnglish ? "./?lang=en" : "./")">@(IsEnglish ? "Home" : "回首頁")</a>
</header>

<main class="profile-page">
    <section class="profile-hero">
        <svg class="profile-wave" viewBox="0 0 1200 260" preserveAspectRatio="none" aria-hidden="true">
            <path d="M0 150 C260 70 470 235 720 205 C930 180 1070 225 1200 110 L1200 260 L0 260 Z" />
        </svg>
        <div class="profile-inner">
            <figure class="profile-image profile-image-miu">
                <img src="images/miu-profile.jpeg" alt="Miu Natsha" />
            </figure>
            <div class="profile-copy">
                <h1>Miu Natsha</h1>
                @if (IsEnglish)
                {
                    <p>Miu Natsha is a Thai actress and model born in Bangkok who has studied at University of the Arts London.<br />She began acting in 2024 and is known for her fresh presence, lively personality and distinctive fashion sense.</p>
                }
                else
                {
                    <p>Miu Natsha 是出生於曼谷的泰國演員與模特兒，曾赴倫敦藝術大學學習。<br />她於 2024 年展開戲劇演出，以清新自然的氣質、真誠活潑的個性與獨特時尚品味受到關注。</p>
                }
            </div>
        </div>
    </section>

    <section class="profile-links">
        <p>Link</p>
        <div>
            <a href="https://x.com/miunatshaa" target="_blank" rel="noopener noreferrer" aria-label="X (Twitter)">X</a>
            <a href="https://www.instagram.com/mmiunatshaa" target="_blank" rel="noopener noreferrer" aria-label="Instagram">IG</a>
            <a href="https://www.tiktok.com/@@miunatsha?_r=1&amp;_t=ZS-98cMwCxLyL6" target="_blank" rel="noopener noreferrer" aria-label="TikTok">Tiktok</a>
            <a href="https://weibo.com/u/7981813219" target="_blank" rel="noopener noreferrer" aria-label="Weibo">微博</a>
            <a href="https://xhslink.cn/m/4mTLDL9pFaU" target="_blank" rel="noopener noreferrer" aria-label="Xiaohongshu">小紅書</a>
        </div>
    </section>
</main>

@code {
    private bool IsEnglish => Navigation.ToAbsoluteUri(Navigation.Uri).Query.Contains("lang=en", StringComparison.OrdinalIgnoreCase);
}
